<?xml version="1.0" encoding="utf-8"?> 
<odoo> 
    <record id="prestamo_equipo_view_list" model="ir.ui.view"> 
        <field name="name">prestamo.equipo.list</field> 
        <field name="model">prestamo.equipo</field> 
        <field name="arch" type="xml"> 
            <list> 
                <field name="codigo"/> 
                <field name="name"/> 
                <field name="categoria"/> 
                <field name="estado"/> 
            </list> 
        </field> 
    </record> 
  
    <record id="prestamo_equipo_view_form" model="ir.ui.view"> 
        <field name="name">prestamo.equipo.form</field> 
        <field name="model">prestamo.equipo</field> 
        <field name="arch" type="xml"> 
            <form> 
            <header>
    <button name="action_enviar_mantenimiento"
            string="Enviar a mantenimiento"
            type="object"
            invisible="estado == 'mantenimiento'"/>

    <button name="action_marcar_disponible"
            string="Marcar disponible"
            type="object"
            invisible="estado == 'disponible'"/>
</header>
            <field name="veces_prestado"/>
                <sheet> 
                    <group> 
                        <group> 
                            <field name="name"/> 
                            <field name="codigo"/> 
                        </group> 
                        <group> 
                            <field name="categoria"/> 
                            <field name="estado"/> 
                            <field name="active"/> 
                        </group> 
                    </group> 
                    <field name="notas" placeholder="Accesorios, estado físico..."/>
                    </sheet> 
            </form> 
        </field> 
    </record> 
  
    <record id="prestamo_equipo_action" model="ir.actions.act_window"> 
        <field name="name">Equipos</field> 
        <field name="res_model">prestamo.equipo</field> 
        <field name="view_mode">list,form</field> 
    </record> 
  
    <menuitem id="prestamo_menu_root" name="Préstamos" sequence="60"/> 
  
    <menuitem id="prestamo_equipo_menu" 
              name="Equipos" 
              parent="prestamo_menu_root" 
              action="prestamo_equipo_action" 
              sequence="20"/> 
</odoo>
<record id="prestamo_equipo_view_kanban" model="ir.ui.view"> 
        <field name="name">prestamo.equipo.kanban</field> 
        <field name="model">prestamo.equipo</field> 
        <field name="arch" type="xml"> 
            <kanban default_group_by="estado"> 
               <field name="veces_prestado"/>
                <templates> 
                    <t t-name="card"> 
                    <div>
    Veces prestado:
    <field name="veces_prestado"/>
</div>
                        <!-- TODO 2: mostrar name en negrita (class="fw-bold"), 
                             codigo y categoria --> 
                    </t> 
                </templates> 
            </kanban> 
        </field> 
    </record> 